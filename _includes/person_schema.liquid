    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Young Jin Yoo",
    "alternateName": ["유영진", "Youngjin Yoo", "Young-Jin Yoo", "Y. J. Yoo"],
    "givenName": "Young Jin",
    "familyName": "Yoo",
    "jobTitle": "Postdoctoral researcher",
    "email": "mailto:yjyoo@mit.edu",
    "url": "https://yjinyoo.github.io/",
    "image": "https://yjinyoo.github.io/assets/img/prof_pic.jpg",
    "knowsAbout": [
      "integrated photonics",
      "membrane-based photonics",
      "remote epitaxy",
      "ferroelectric photonics",
      "electro-optic modulators",
      "nanophotonics"
    ],
    "affiliation": {
      "@type": "Organization",
      "name": "Research Laboratory of Electronics, Massachusetts Institute of Technology",
      "url": "https://www.rle.mit.edu/"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
