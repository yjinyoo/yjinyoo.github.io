{%- comment -%}
Typography overrides. The theme's stylesheet lives inside the al-folio gem, so
it is not edited here; these rules are layered on top from each page instead.

Measured before changing: body was 1rem / 1.5 line-height, and headings carried
no explicit size, so h2 and h4 sat too close to body text to separate sections.
{%- endcomment -%}
<style>
  /* Accent colour. The theme ships magenta in light mode and cyan in dark, which
     left the page with two unrelated accents: magenta links against the green
     activity chart. One accent now, taken from the chart. */
  :root {
    --global-theme-color: #2f6f4e;
    --global-hover-color: #24563d;
  }
  html[data-theme="dark"] {
    --global-theme-color: #7cc39b;
    --global-hover-color: #a5dabd;
  }

  /* Body copy: a touch larger and more open than the 1rem / 1.5 default. */
  .post article p,
  .post article li {
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .post article li {
    margin-bottom: 0.35rem;
  }

  /* The address block under the photo is a caption, not body copy. */
  .post .more-info p {
    font-size: 0.85rem;
    line-height: 1.45;
  }

  /* Section headings, sized to step down clearly from the page title. */
  .post article h2 {
    font-size: 1.55rem;
    font-weight: 700;
    margin: 2.4rem 0 0.8rem;
  }
  .post article h4 {
    font-size: 1.16rem;
    font-weight: 600;
    margin: 1.9rem 0 0.55rem;
  }

  /* The theme bolds the given name only, which reads as a mistake rather than
     as a device. One weight for the whole name, in the page title and in the
     navbar, where the anchor also carries font-weight-lighter. */
  .post-title,
  .post-title .font-weight-bold,
  .navbar-brand.title,
  .navbar-brand.title .font-weight-bold {
    font-weight: 700;
  }
  .post-header .desc {
    font-size: 0.98rem;
    line-height: 1.55;
  }

  /* Publication numbers. The theme renders `abbr` as a filled pill whose text
     colour is the card background, set with !important, so the digits were
     white on white once the pill was removed. Its selector also outranks a
     plain `.publications .abbr .badge`, so this one matches it and adds a
     class to win on specificity. */
  .publications ol.bibliography li .abbr abbr.badge {
    background: none !important;
    background-color: transparent !important;
    color: #6b7280 !important;
    font-size: 1rem;
    font-weight: 600;
    padding: 0;
    width: auto !important;
    text-align: left;
    border-radius: 0;
  }

  /* Equal-contribution note: its own line, set back from the citation. */
  .publications .periodical + .periodical {
    font-size: 0.88rem;
    color: #8b929c;
    margin-top: 0.15rem;
  }

  /* Paper titles link to the paper (_layouts/bib.liquid). At rest they keep the
     text colour so the list does not turn into a column of green; on hover they
     take the accent and an underline, which is how the reader finds the link. */
  .publications ol.bibliography li .title a {
    color: inherit;
  }
  .publications ol.bibliography li .title a:hover {
    color: var(--global-theme-color);
    text-decoration: underline;
  }
</style>
